<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Flow.Launcher.Plugin.SmartCalc</AssemblyName>
    <RootNamespace>Flow.Launcher.Plugin.SmartCalc</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <Page Remove="Languages\*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Flow provides this assembly at run time -->
    <PackageReference Include="Flow.Launcher.Plugin" Version="5.3.1" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="plugin.json;Images\icon.png;Languages\*.xaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
